# ===========================================
# Arbitrage Bot Configuration
# ===========================================

# General Settings
BOT_ENV=development
LOG_LEVEL=INFO
DRY_RUN=true

# ===========================================
# Polymarket Configuration
# ===========================================
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_API_SECRET=your_api_secret_here
POLYMARKET_API_PASSPHRASE=your_passphrase_here

# ===========================================
# Alternative Markets
# ===========================================

# Kalshi
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_password_here

# PredictIt (read-only, no trading API)
PREDICTIT_API_URL=https://www.predictit.org/api

# Manifold Markets
MANIFOLD_API_URL=https://api.manifold.markets/v0
MANIFOLD_API_KEY=your_manifold_api_key

# Metaculus (read-only)
METACULUS_API_URL=https://www.metaculus.com/api2

# ===========================================
# Risk Management
# ===========================================
MAX_POSITION_SIZE_USD=1000
MAX_TOTAL_EXPOSURE_USD=5000
MIN_PROFIT_THRESHOLD_PERCENT=2.0
MAX_SLIPPAGE_PERCENT=1.0
STOP_LOSS_PERCENT=5.0
MAX_TRADES_PER_HOUR=20
COOLDOWN_AFTER_LOSS_SECONDS=300

# ===========================================
# Database
# ===========================================
DATABASE_URL=sqlite+aiosqlite:///./arbitrage_bot.db

# ===========================================
# Notifications
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

DISCORD_WEBHOOK_URL=your_discord_webhook_url

# ===========================================
# Monitoring
# ===========================================
PROMETHEUS_PORT=9090
HEALTH_CHECK_PORT=8080
