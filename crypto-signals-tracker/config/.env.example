# =============================================
# CONFIGURATION TELEGRAM - COMPTE UTILISATEUR
# =============================================
# Obtenir sur https://my.telegram.org/apps
# 1. Connectez-vous avec votre numéro de téléphone
# 2. Cliquez sur "API development tools"
# 3. Créez une nouvelle application
# 4. Copiez api_id et api_hash
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=votre_api_hash_ici

# Votre numéro de téléphone (format international)
TELEGRAM_PHONE=+33612345678

# =============================================
# CONFIGURATION BOT TELEGRAM (pour les rapports)
# =============================================
# Créer un bot via @BotFather sur Telegram
# 1. Envoyez /newbot à @BotFather
# 2. Suivez les instructions
# 3. Copiez le token
BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz

# Votre ID utilisateur Telegram (pour recevoir les rapports)
# Obtenir via @userinfobot sur Telegram
ADMIN_USER_ID=123456789

# =============================================
# CONFIGURATION DES GROUPES CIBLES
# =============================================
# Noms des groupes a surveiller (separes par des virgules)
TARGET_GROUPS=CryptoMau BTC Scalp Signals,CryptoMau VIP Binance Trading Signals

# IDs des groupes (separes par des virgules, remplis apres le setup)
# Doivent correspondre dans le meme ordre que TARGET_GROUPS
TARGET_GROUP_IDS=-1001433646525,-1001306509155

# =============================================
# CONFIGURATION BASE DE DONNÉES
# =============================================
DATABASE_PATH=./database/signals.db

# =============================================
# CONFIGURATION LOGS
# =============================================
LOG_LEVEL=info
LOG_PATH=./logs/app.log

# =============================================
# CONFIGURATION RAPPORTS
# =============================================
# Heure du rapport quotidien (format HH:MM, fuseau horaire du serveur)
DAILY_REPORT_TIME=23:00
# Jour et heure du rapport hebdomadaire (0=dimanche)
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_TIME=23:00

# =============================================
# CONFIGURATION PORTEFEUILLE VIRTUEL
# =============================================
# Capital de depart en dollars
VIRTUAL_PORTFOLIO_START=200
# Taille maximale d'une position (% du capital)
MAX_POSITION_SIZE_PERCENT=10
# Frais de transaction (% applique a l'entree et a la sortie)
TRADING_FEE_PERCENT=0.5
# Heure du rapport portfolio quotidien (format HH:MM)
PORTFOLIO_REPORT_TIME=21:59

# =============================================
# CONFIGURATION BINANCE API (lecture seule)
# =============================================
# Creer une cle API sur https://www.binance.com/en/my/settings/api-management
# IMPORTANT : Configurer en READ-ONLY + IP whitelisting
BINANCE_API_KEY=votre_api_key_ici
BINANCE_API_SECRET=votre_api_secret_ici

# =============================================
# CONFIGURATION TRADING AUTOMATIQUE
# =============================================
# Mode de trading : simulation (virtuel), testnet (Binance testnet), live (argent reel)
TRADING_MODE=simulation
# Activer le passage d'ordres automatique (false = observation uniquement)
ENABLE_AUTO_TRADING=false
# Taille max d'une position en % du capital Binance
MAX_POSITION_PERCENT=5
# Nombre max de trades par jour
MAX_DAILY_TRADES=20
# Perte max quotidienne en % → arret automatique si depasse
MAX_DAILY_LOSS_PERCENT=10
# Bouton kill switch dans le dashboard (ferme tout d'urgence)
ENABLE_KILL_SWITCH=true

# =============================================
# BINANCE TESTNET FUTURES (pour tests sans risque)
# =============================================
# Creer un compte sur https://testnet.binancefuture.com/
# Se connecter avec GitHub, obtenir les cles API
BINANCE_TESTNET_API_KEY=votre_cle_testnet_ici
BINANCE_TESTNET_API_SECRET=votre_secret_testnet_ici

# =============================================
# CONFIGURATION DASHBOARD WEB
# =============================================
# Port du serveur web (default: 3001)
DASHBOARD_PORT=3001
# Identifiant de connexion au dashboard
DASHBOARD_USER=admin
# Mot de passe de connexion au dashboard (OBLIGATOIRE)
DASHBOARD_PASSWORD=changez_moi_svp
# Secret pour les sessions (genere automatiquement si vide)
DASHBOARD_SECRET=
